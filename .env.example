# Environment variables template for mreavideo
# Copy to .env.local and populate with your credentials (DO NOT COMMIT .env.local)

# GitHub Personal Access Token (for dual-remote push & releases)
GITHUB_TOKEN=your_github_token_here

# Multimodal Vision LLM (Optional - if running run.py --vlm)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Environment variables template for mreavideo
# Copy to .env.local (preferred) or .env and populate with your credentials (NEVER COMMIT .env.local or .env)

# GitHub Personal Access Token (for scripts/push_dual.py dual-remote push)
GITHUB_TOKEN=your_github_token_here

# Multimodal Vision LLM (Optional - used when running `run.py --vlm`)
# Option A: Direct REA_VLM_* configuration (any OpenAI-compatible multimodal endpoint)
REA_VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
REA_VLM_API_KEY=
REA_VLM_MODEL=gemini-2.5-flash,gemini-2.5-pro

# Option B: Shorthand keys (auto-bridged by run.py if REA_VLM_API_KEY is empty)
GEMINI_API_KEY=
OPENAI_API_KEY=
